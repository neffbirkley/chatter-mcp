{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    ["@semantic-release/npm", { "pkgRoot": "packages/mcp" }],
    ["@semantic-release/npm", { "pkgRoot": "packages/cli" }],
    [
      "@semantic-release/github",
      { "assets": [], "successComment": false, "failComment": false, "labels": false }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "packages/mcp/package.json", "packages/cli/package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
